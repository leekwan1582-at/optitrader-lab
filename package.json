{
  "name": "optitrader-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w @optitrader/backend",
    "dev:frontend": "npm run dev -w @optitrader/frontend",
    "build": "npm run build -w @optitrader/shared && npm run build -w @optitrader/backend && npm run build -w @optitrader/frontend",
    "typecheck": "npm run typecheck -w @optitrader/shared && npm run typecheck -w @optitrader/backend && npm run typecheck -w @optitrader/frontend",
    "test": "npm run test -w @optitrader/backend",
    "test:engine": "./.venv/bin/python -m pytest packages/backend/engine/tests -q",
    "lint": "eslint",
    "lint:all": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
