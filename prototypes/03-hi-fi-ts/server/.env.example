# Server Configuration
# Copy this file to .env and fill in the values. Never commit .env.
PORT=5000
NODE_ENV=development

# Database Configuration
# Local: mongodb://localhost:27017/optitrader_lab
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/optitrader_lab?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/optitrader_lab

# Authentication
# Leave empty for development if auth is not enabled.
# Required when NODE_ENV=production; use a strong random value.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# AI Integration
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Must be a model available in your AI Studio account (read from this variable, not hardcoded).
GEMINI_MODEL=gemini-2.5-flash

# Client URL (CORS origin; must match the Vite origin exactly, no trailing slash or path)
CLIENT_URL=http://localhost:5173
