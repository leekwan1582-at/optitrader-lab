# API Configuration
# Vite only exposes variables prefixed with VITE_ to the browser.
# Never put secrets (GEMINI_API_KEY, JWT_SECRET, MONGO_URI) in this file.
# The /api suffix must match the Express route prefix.
VITE_API_URL=http://localhost:5000/api

# The high-fidelity PoC runs against local mock data by default.
# Set to false to use the live Express API.
VITE_USE_MOCK_API=true
