{
  "name": "optitrader-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "react-bootstrap": "^2.10.10",
    "zod": "^4.6.7"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "node --test 'test/*.test.js' '../test/*.test.js'",
    "test:config": "node --test test/config.test.js",
    "test:bridge": "node --test ../test/bridge.test.js",
    "config:check": "node --input-type=module -e \"import 'dotenv/config'; import { loadConfig } from './config.js'; loadConfig(); console.log('✅ Configuration valid')\""
  },
  "allowScripts": {
    "@google/genai@2.31.0": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
