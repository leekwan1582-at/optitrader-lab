# API Configuration
# Vite only exposes variables prefixed with VITE_ to the browser.
# Never put secrets (GEMINI_API_KEY, JWT_SECRET, MONGO_URI) in this file.
# Relative /api ensures requests pass through Vite dev proxy for same-site HttpOnly cookies.
VITE_API_URL=/api

# Live API mode is the default.
# In local development only, set to true to fall back to in-memory mock data.
VITE_USE_MOCK_API=false

